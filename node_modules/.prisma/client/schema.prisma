generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ResumeAnalysis {
  id              String   @id @default(cuid())
  fileName        String
  score           Int
  strengths       Json
  weaknesses      Json
  suggestions     Json
  overallFeedback String
  createdAt       DateTime @default(now())
}
